
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | Campus Hub</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-page">
  <main class="auth-main">
    <div class="auth-layout">
      <section class="auth-visual">
        <a href="/" class="auth-brand">Campus Hub.</a>

        <div class="auth-visual-content">
          <h2>Your campus.<br>Your community.</h2>
          <p>
            Reconnect with campus life, discover student clubs,
            explore opportunities, and stay updated.
          </p>
        </div>

        <div class="auth-benefits">
          <div class="auth-benefit">
            <span class="auth-benefit-icon">✦</span>
            <span>Discover student communities</span>
          </div>
          <div class="auth-benefit">
            <span class="auth-benefit-icon">✓</span>
            <span>Stay connected with campus updates</span>
          </div>
        </div>
      </section>

      <section class="auth-form-panel">
        <div class="auth-form-heading">
          <span class="auth-eyebrow">Welcome back</span>
          <h1>Sign in to Campus Hub</h1>
          <p>Enter your account details to continue.</p>
        </div>

        <% if (error) { %>
          <div class="auth-error" role="alert"><%= error %></div>
        <% } %>

        <form class="auth-form" action="/login" method="POST">
          <div class="auth-field">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              maxlength="254"
              required
            >
          </div>

          <div class="auth-field">
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="Enter your password"
              required
            >
          </div>
          
<div class="forgot-password-row">
  <a href="/forgot-password">Forgot password?</a>
</div>


          <button class="auth-submit" type="submit">
            Sign In →
          </button>
        </form>

        <p class="auth-switch">
          Don't have an account?
          <a href="/register">Create account</a>
        </p>
      </section>
    </div>
  </main>

  <footer class="auth-footer">
    © <%= new Date().getFullYear() %> Campus Hub. Built for campus life.
  </footer>
</body>
</html>
