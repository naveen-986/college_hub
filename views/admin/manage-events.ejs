
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Manage Events | Campus Hub</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/manage-events.css">
</head>

<body>

    <%- include("../partials/navbar") %>

    <main class="container events-page">

        <!-- Back Navigation -->
        <a href="/clubs/<%= club.slug %>">
            ← Back to Club
        </a>

        <!-- Page Heading -->
        <h1>Event Management</h1>

        <p>
            Manage events for
            <strong><%= club.name %></strong>
        </p>

        <!-- Create Event Form -->
        <h2>Create New Event</h2>

        <form
            class="create-event-form"
            method="POST"
            action="/admin/clubs/<%= club.slug %>/events"
        >

            <input
                type="text"
                name="name"
                placeholder="Enter event name"
                maxlength="150"
                required
            >

            <textarea
                name="description"
                placeholder="Describe your event..."
                maxlength="2000"
            ></textarea>

            <input
                type="date"
                name="date"
                required
            >

            <input
                type="text"
                name="venue"
                placeholder="Enter event venue"
                maxlength="200"
            >

            <button type="submit">
                + Create Event
            </button>

        </form>

        <hr>

        <!-- Existing Events -->
        <h2>Existing Events</h2>

        <% if (club.events && club.events.length > 0) { %>

            <% club.events.forEach(event => { %>

                <div class="event-card">

                    <h3>
                        <%= event.name %>
                    </h3>

                    <p>
                        <%= event.description || "No description available." %>
                    </p>

                    <p>
                        <strong>Date:</strong>
                        <%= event.date %>
                    </p>

                    <p>
                        <strong>Venue:</strong>
                        <%= event.venue || "Not specified" %>
                    </p>

                    <p>
                        <strong>Registrations:</strong>
                        <%= event.registrations
                            ? event.registrations.length
                            : 0 %>
                    </p>

                    <!-- Delete Event -->
                    <form
                        method="POST"
                        action="/admin/clubs/<%= club.slug %>/events/<%= event._id %>/delete"
                        onsubmit="return confirm('Are you sure you want to delete this event?')"
                    >

                        <button type="submit">
                            Delete Event
                        </button>

                    </form>

                </div>

            <% }); %>

        <% } else { %>

            <p>No events created yet.</p>

        <% } %>

    </main>

    <%- include("../partials/footer") %>

</body>
</html>
