
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Notice | CampusHub</title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/create-notice.css">
</head>

<body>

  <%- include("../partials/navbar") %>

  <main class="notice-form-container">

    <h1>Edit Notice</h1>
    <p>Update the announcement details.</p>

    <form action="/notices/<%= notice._id %>/edit" method="POST">

      <div class="form-group">
        <label for="title">Notice Title</label>
        <input
          type="text"
          id="title"
          name="title"
          value="<%= notice.title %>"
          maxlength="150"
          required
        >
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea
          id="description"
          name="description"
          rows="6"
          maxlength="3000"
          required
        ><%= notice.description %></textarea>
      </div>

      <div class="form-group">
        <label for="category">Category</label>

        <select id="category" name="category" required>
          <% const categories = [
            "Academic",
            "Examination",
            "Events",
            "Placement",
            "General"
          ]; %>

          <% categories.forEach(category => { %>
            <option
              value="<%= category %>"
              <%= notice.category === category ? "selected" : "" %>
            >
              <%= category %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-actions">
        <button type="submit">Update Notice</button>
        <a href="/notices" class="cancel-btn">Cancel</a>
      </div>

    </form>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>
